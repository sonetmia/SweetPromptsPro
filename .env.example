# SweetPrompts Pro - Environment Configuration Example
# Copy to .env (local dev) or configure in Vercel Project Settings.
#
# SECURITY WARNING: never use VITE_-prefixed names for secrets.
# Vite bakes VITE_* variables into the public JS bundle, so anyone
# visiting the site could steal the key. Use the plain names below —
# they stay on the server only.
#
# Note: SweetPrompts Pro also supports direct in-app API key configuration
# in Settings (stored in your browser's localStorage). Only use that on
# devices you trust.

# Google Gemini API Key (Recommended for Adobe Stock Prompt Engine & Vision Analysis)
GEMINI_API_KEY=<your-gemini-api-key>

# Groq Cloud API Key (Ultra-Fast LPU Inference)
GROQ_API_KEY=<your-groq-api-key>

# Mistral AI API Key
MISTRAL_API_KEY=<your-mistral-api-key>

# OpenRouter API Key (Claude, GPT, DeepSeek)
OPENROUTER_API_KEY=<your-openrouter-api-key>

# Hugging Face Inference API Token
HUGGINGFACE_API_KEY=<your-huggingface-token>

# Cerebras Cloud API Key
CEREBRAS_API_KEY=<your-cerebras-api-key>
